{
  "openapi": "3.1.0",
  "info": {
    "title": "Loan Management System API",
    "version": "1.0.0",
    "description": "Canonical API contract. All endpoint changes must update this document before implementation. Authentication uses the HttpOnly cookie scheme below. All /api operations may return 429 when their rate limit is exceeded; login has a stricter limit."
  },
  "servers": [{ "url": "/", "description": "Same-origin application server" }],
  "tags": [
    { "name": "Authentication" },
    { "name": "Users" },
    { "name": "Roles" },
    { "name": "Stakeholders" },
    { "name": "Loans" },
    { "name": "Payments" }
  ],
  "security": [{ "cookieAuth": [] }],
  "paths": {
    "/hello": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Health check",
        "security": [],
        "responses": { "200": { "description": "Server response", "content": { "text/plain": { "schema": { "type": "string", "example": "Hello Vite + React!" } } } } }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Start an authenticated session",
        "description": "Target behavior sets the JWT in an HttpOnly, Secure, SameSite=Strict cookie. The response never exposes the JWT to browser JavaScript.",
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginInput" } } } },
        "responses": {
          "200": { "description": "Authenticated user and JWT cookie", "headers": { "Set-Cookie": { "$ref": "#/components/headers/AuthCookie" } }, "content": { "application/json": { "schema": { "type": "object", "required": ["user"], "properties": { "user": { "$ref": "#/components/schemas/AuthUser" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "End the authenticated session",
        "description": "Clears the JWT cookie using matching HttpOnly, Secure, SameSite=Strict, and Path attributes. This operation is safe to call without an active session.",
        "security": [],
        "responses": {
          "204": { "description": "JWT cookie cleared", "headers": { "Set-Cookie": { "$ref": "#/components/headers/ClearedAuthCookie" } } },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List user accounts",
        "description": "Intentional authenticated global-read exception: every authenticated role can enumerate user accounts. Password hashes are excluded. This endpoint is not lender-scoped.",
        "responses": { "200": { "$ref": "#/components/responses/UserList" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/PasswordChangeRequired" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/users/auth": {
      "get": {
        "tags": ["Users"],
        "summary": "Get the current authenticated user",
        "description": "Allowed while a password change is required.",
        "responses": { "200": { "$ref": "#/components/responses/AuthUser" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/users/me/password": {
      "patch": {
        "tags": ["Users"],
        "summary": "Change the current user's password",
        "description": "Allowed while a password change is required.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordChangeInput" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Message" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/roles": {
      "get": {
        "tags": ["Roles"],
        "summary": "List access roles",
        "responses": { "200": { "$ref": "#/components/responses/RoleList" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/PasswordChangeRequired" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/admin/users": {
      "post": {
        "tags": ["Users"],
        "summary": "Create an admin or lender account",
        "description": "Admin only. The selected stakeholder must exist and not already be linked to an account. The temporary password is returned once.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminUserCreateInput" } } } },
        "responses": { "201": { "$ref": "#/components/responses/TemporaryPasswordUser" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/admin/users/{userId}/reset-password": {
      "post": {
        "tags": ["Users"],
        "summary": "Reset a user's password",
        "description": "Admin only. Returns a one-time temporary password and forces a password change.",
        "parameters": [{ "$ref": "#/components/parameters/UserId" }],
        "responses": { "200": { "$ref": "#/components/responses/TemporaryPasswordUser" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/admin/users/{userId}": {
      "patch": {
        "tags": ["Users"],
        "summary": "Change a user's role or active state",
        "description": "Admin only. The last active admin cannot be demoted or deactivated.",
        "parameters": [{ "$ref": "#/components/parameters/UserId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminUserUpdateInput" } } } },
        "responses": { "200": { "$ref": "#/components/responses/User" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/stakeholders": {
      "get": {
        "tags": ["Stakeholders"],
        "summary": "List stakeholders",
        "description": "Intentional authenticated global-read exception: every authenticated role can enumerate stakeholders. Records are ordered by last and first name; this endpoint is not lender-scoped.",
        "responses": { "200": { "$ref": "#/components/responses/StakeholderList" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/PasswordChangeRequired" }, "500": { "$ref": "#/components/responses/InternalError" } }
      },
      "post": {
        "tags": ["Stakeholders"],
        "summary": "Create a stakeholder",
        "description": "Admin only.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StakeholderInput" } } } },
        "responses": { "201": { "$ref": "#/components/responses/Stakeholder" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/stakeholders/{id}": {
      "get": {
        "tags": ["Stakeholders"], "summary": "Get a stakeholder", "description": "Intentional authenticated global-read exception; this endpoint is not lender-scoped.", "parameters": [{ "$ref": "#/components/parameters/StakeholderId" }],
        "responses": { "200": { "$ref": "#/components/responses/Stakeholder" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/PasswordChangeRequired" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/InternalError" } }
      },
      "put": {
        "tags": ["Stakeholders"], "summary": "Replace a stakeholder", "description": "Admin only; omitted optional fields become null.", "parameters": [{ "$ref": "#/components/parameters/StakeholderId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StakeholderInput" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Stakeholder" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      },
      "patch": {
        "tags": ["Stakeholders"], "summary": "Update a stakeholder", "description": "Admin only.", "parameters": [{ "$ref": "#/components/parameters/StakeholderId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StakeholderPatchInput" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Stakeholder" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      },
      "delete": {
        "tags": ["Stakeholders"], "summary": "Delete a stakeholder", "description": "Admin only. Referenced stakeholders cannot be deleted.", "parameters": [{ "$ref": "#/components/parameters/StakeholderId" }],
        "responses": { "204": { "description": "Deleted" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/loans": {
      "get": {
        "tags": ["Loans"], "summary": "List accessible loans", "description": "Admins receive all loans. Lenders receive only loans where lender_id equals their linked stakeholder_id.",
        "responses": { "200": { "$ref": "#/components/responses/LoanList" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "500": { "$ref": "#/components/responses/InternalError" } }
      },
      "post": {
        "tags": ["Loans"], "summary": "Create a loan", "description": "Admins choose lender_id. A lender's lender_id is derived from the session and cannot be another stakeholder.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoanInput" } } } },
        "responses": { "201": { "$ref": "#/components/responses/Loan" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/loans/{id}": {
      "get": {
        "tags": ["Loans"], "summary": "Get an accessible loan", "description": "An inaccessible lender-owned loan returns 404.", "parameters": [{ "$ref": "#/components/parameters/LoanId" }],
        "responses": { "200": { "$ref": "#/components/responses/Loan" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/InternalError" } }
      },
      "put": {
        "tags": ["Loans"], "summary": "Replace an accessible loan", "description": "Requires complete relationship arrays. Paid loans cannot be replaced.", "parameters": [{ "$ref": "#/components/parameters/LoanId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoanInput" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Loan" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      },
      "patch": {
        "tags": ["Loans"], "summary": "Update an accessible loan", "description": "Financial changes require installments. Paid loans accept only guarantors and collaterals, plus lender_id for admins.", "parameters": [{ "$ref": "#/components/parameters/LoanId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoanPatchInput" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Loan" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      },
      "delete": {
        "tags": ["Loans"], "summary": "Delete an accessible loan", "description": "Loans with payments cannot be deleted.", "parameters": [{ "$ref": "#/components/parameters/LoanId" }],
        "responses": { "204": { "description": "Deleted" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/payments": {
      "get": {
        "tags": ["Payments"], "summary": "List accessible payments", "description": "Admins receive all payments. Lenders receive payments only for their own loans.",
        "parameters": [{ "name": "loan_id", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1 } }],
        "responses": { "200": { "$ref": "#/components/responses/PaymentList" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/payments/installment": {
      "post": {
        "tags": ["Payments"], "summary": "Record a full installment payment", "description": "Accessible loan required. Amount must exactly equal the pending installment amount.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InstallmentPaymentInput" } } } },
        "responses": { "201": { "$ref": "#/components/responses/Payment" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/payments/interest": {
      "post": {
        "tags": ["Payments"], "summary": "Record a separate-interest payment", "description": "Accessible separate-interest loan required. Amount must exactly equal the pending interest amount.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InterestPaymentInput" } } } },
        "responses": { "201": { "$ref": "#/components/responses/Payment" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    },
    "/api/payments/{id}": {
      "get": {
        "tags": ["Payments"], "summary": "Get an accessible payment", "parameters": [{ "$ref": "#/components/parameters/PaymentId" }],
        "responses": { "200": { "$ref": "#/components/responses/Payment" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "500": { "$ref": "#/components/responses/InternalError" } }
      },
      "patch": {
        "tags": ["Payments"], "summary": "Correct a payment date", "description": "Only paid_at can be changed.", "parameters": [{ "$ref": "#/components/parameters/PaymentId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentDateUpdateInput" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Payment" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      },
      "delete": {
        "tags": ["Payments"], "summary": "Reverse a payment", "description": "Restores the installment or interest obligation to pending.", "parameters": [{ "$ref": "#/components/parameters/PaymentId" }],
        "responses": { "204": { "description": "Reversed" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "500": { "$ref": "#/components/responses/InternalError" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "access_token", "description": "JWT stored in an HttpOnly, Secure, SameSite=Strict cookie." } },
    "headers": {
      "AuthCookie": { "description": "HttpOnly JWT session cookie.", "schema": { "type": "string", "example": "access_token=<jwt>; HttpOnly; Secure; SameSite=Strict; Path=/" } },
      "ClearedAuthCookie": { "description": "Expired JWT session cookie.", "schema": { "type": "string", "example": "access_token=; HttpOnly; Secure; SameSite=Strict; Path=/; Max-Age=0" } }
    },
    "parameters": {
      "UserId": { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "StakeholderId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "LoanId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "PaymentId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }
    },
    "schemas": {
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } } },
      "Message": { "type": "object", "required": ["message"], "properties": { "message": { "type": "string" } } },
      "Role": { "type": "object", "required": ["role_id", "role_name"], "properties": { "role_id": { "type": "integer" }, "role_name": { "type": "string", "enum": ["admin", "lender"] } } },
      "Stakeholder": { "type": "object", "required": ["stakeholder_id", "first_name", "last_name"], "properties": { "stakeholder_id": { "type": "integer" }, "first_name": { "type": "string" }, "last_name": { "type": "string" }, "national_id": { "type": ["string", "null"] }, "marital_status": { "type": ["string", "null"], "enum": ["single", "married", null] }, "occupation": { "type": ["string", "null"] }, "date_of_birth": { "type": ["string", "null"], "format": "date" } } },
      "User": { "type": "object", "required": ["user_id", "email", "role_id", "stakeholder_id", "is_active", "must_change_password"], "properties": { "user_id": { "type": "integer" }, "email": { "type": "string", "format": "email" }, "role_id": { "type": "integer" }, "stakeholder_id": { "type": "integer" }, "is_active": { "type": "boolean" }, "must_change_password": { "type": "boolean" }, "Stakeholder": { "$ref": "#/components/schemas/Stakeholder" }, "Role": { "$ref": "#/components/schemas/Role" } } },
      "AuthUser": { "allOf": [{ "$ref": "#/components/schemas/User" }] },
      "LoginInput": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "minLength": 1 } } },
      "PasswordChangeInput": { "type": "object", "required": ["current_password", "new_password"], "properties": { "current_password": { "type": "string", "minLength": 1 }, "new_password": { "type": "string", "minLength": 1 } } },
      "AdminUserCreateInput": { "type": "object", "required": ["email", "stakeholder_id", "role_name"], "properties": { "email": { "type": "string", "format": "email" }, "stakeholder_id": { "type": "integer", "minimum": 1 }, "role_name": { "type": "string", "enum": ["admin", "lender"] } } },
      "AdminUserUpdateInput": { "type": "object", "minProperties": 1, "properties": { "role_name": { "type": "string", "enum": ["admin", "lender"] }, "is_active": { "type": "boolean" } } },
      "TemporaryPasswordUser": { "allOf": [{ "$ref": "#/components/schemas/User" }, { "type": "object", "required": ["temporary_password"], "properties": { "temporary_password": { "type": "string", "description": "Shown once; do not persist or log." } } }] },
      "StakeholderInput": { "type": "object", "required": ["first_name", "last_name"], "properties": { "first_name": { "type": "string", "minLength": 1, "maxLength": 100 }, "last_name": { "type": "string", "minLength": 1, "maxLength": 100 }, "national_id": { "type": ["string", "null"], "maxLength": 30 }, "marital_status": { "type": ["string", "null"], "enum": ["single", "married", null] }, "occupation": { "type": ["string", "null"], "maxLength": 100 }, "date_of_birth": { "type": ["string", "null"], "format": "date" } } },
      "StakeholderPatchInput": { "type": "object", "minProperties": 1, "properties": { "first_name": { "type": "string", "minLength": 1, "maxLength": 100 }, "last_name": { "type": "string", "minLength": 1, "maxLength": 100 }, "national_id": { "type": ["string", "null"], "maxLength": 30 }, "marital_status": { "type": ["string", "null"], "enum": ["single", "married", null] }, "occupation": { "type": ["string", "null"], "maxLength": 100 }, "date_of_birth": { "type": ["string", "null"], "format": "date" } } },
      "InstallmentInput": { "type": "object", "required": ["installment_number", "amount_due", "due_date"], "properties": { "installment_number": { "type": "integer", "minimum": 1 }, "amount_due": { "type": "number", "exclusiveMinimum": 0 }, "due_date": { "type": "string", "format": "date" } } },
      "GuarantorInput": { "oneOf": [{ "type": "object", "required": ["stakeholder_id"], "properties": { "stakeholder_id": { "type": "integer", "minimum": 1 } } }, { "$ref": "#/components/schemas/StakeholderInput" }] },
      "CollateralInput": { "type": "object", "required": ["description"], "properties": { "description": { "type": "string", "minLength": 1 }, "estimated_value": { "type": ["number", "null"], "minimum": 0 } } },
